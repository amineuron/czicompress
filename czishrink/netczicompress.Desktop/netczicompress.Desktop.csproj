<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>..\netczicompress\Assets\netczicompress.ico</ApplicationIcon>
		<AssemblyName>CziShrink</AssemblyName>
		<Platforms>x64</Platforms>
		<ScientificToolsDirectory Condition="'$(ScientificToolsDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\hdf5-tiff-tools</ScientificToolsDirectory>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="..\LICENSE.txt" Link="LICENSE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\THIRD_PARTY_LICENSES_ARTIFACT_DISTRIBUTION.txt" Link="THIRD_PARTY_LICENSES_ARTIFACT_DISTRIBUTION.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\README.pdf" Link="README.pdf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="$(ScientificToolsDirectory)\**\*" Link="FormatTools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Exclude="$(ScientificToolsDirectory)\**\__pycache__\**;$(ScientificToolsDirectory)\**\*.pyc;$(ScientificToolsDirectory)\downloads\**;$(ScientificToolsDirectory)\*.py;$(ScientificToolsDirectory)\requirements*.txt" />
		<Content Include="..\ScientificFormats\*.py" Link="FormatTools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<Content Include="..\ScientificFormats\requirements*.txt" Link="FormatTools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
		<Content Include="..\ScientificFormats\README.md" Link="FormatTools\README.md" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" />
		<PackageReference Include="Projektanker.Icons.Avalonia.FontAwesome" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\netczicompress\netczicompress.csproj" />
	</ItemGroup>
</Project>
